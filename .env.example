# Anytype JSON API (desktop app: 31009, anytype-cli headless: 31012)
ANYTYPE_API_URL=http://127.0.0.1:31009
# Scoped API key from Anytype: Settings > API Keys
ANYTYPE_API_KEY=

# MCP HTTP server
HOST=127.0.0.1
PORT=3000
# Extra Host header values to accept, e.g. your tunnel domain (comma-separated)
ALLOWED_HOSTS=
