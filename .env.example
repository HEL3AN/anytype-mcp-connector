# Anytype JSON API (desktop app: 31009, anytype-cli headless: 31012)
ANYTYPE_API_URL=http://127.0.0.1:31009
# Scoped, named API key from Anytype: Settings > API Keys
ANYTYPE_API_KEY=

# MCP HTTP server (keep HOST on loopback; expose it through a tunnel / reverse proxy)
HOST=127.0.0.1
PORT=3000
# Public HTTPS origin Claude uses to reach this server, e.g. https://anytype.example.com
PUBLIC_URL=http://localhost:3000
# Extra Host header values to accept besides PUBLIC_URL's host (comma-separated)
ALLOWED_HOSTS=

# OAuth: password you type on the consent page when connecting Claude (min 12 chars)
OWNER_PASSWORD=
# Where OAuth clients, refresh tokens and the signing key are stored
DATA_DIR=data
# Additional redirect URIs for non-Claude MCP clients (comma-separated)
EXTRA_REDIRECT_URIS=
# Local development only (requires loopback HOST): skip OAuth on /mcp
AUTH_DISABLED=false
