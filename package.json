{
  "name": "anytype-mcp-connector",
  "version": "0.2.1",
  "description": "Remote MCP connector for Anytype (Claude)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "smoke": "tsx scripts/smoke.ts",
    "oauth-e2e": "tsx scripts/oauth-e2e.ts",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "e2e": "tsx scripts/e2e.ts"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
