# Copy to deploy/.env and fill in (setup.sh does this for you). Never commit the real file.

# Public hostname (DNS A/AAAA record must point to this server)
DOMAIN=anytype.example.com

# Reverse proxy:
#   caddy   - bundled Caddy takes ports 80/443 and gets a certificate automatically
#   (empty) - a proxy already runs on the host (nginx, ...); point it at 127.0.0.1:CONNECTOR_PORT
COMPOSE_PROFILES=caddy
CONNECTOR_PORT=3040

# Password you enter on the consent page when connecting Claude (min 12 chars)
OWNER_PASSWORD=

# Anytype API key created by setup.sh
ANYTYPE_API_KEY=

# Connector image: the latest release (or pin a version, e.g. :0.3.0). Leave empty to build from this
# checkout instead (needs Docker Buildx), e.g. for local changes or forks.
CONNECTOR_IMAGE=ghcr.io/hel3an/anytype-mcp-connector:latest

# Pinned images. Bump these deliberately and run update.sh.
ANYTYPE_CLI_IMAGE=ghcr.io/anyproto/anytype-cli:v0.4.0
CADDY_IMAGE=caddy:2.11-alpine

# Optional: Google Search Console HTML-tag verification token (content="..." value).
# Claude shows connector icons from Google's favicon service, which only knows indexed sites.
GOOGLE_SITE_VERIFICATION=
